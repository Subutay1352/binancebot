# cp backtest.env.example backtest.env — API key / DATABASE yok
#
# B = botta kullanılan ama backtest sinyalinde olmayan (Asian, HTF, funding, scanner…)
# A = Decide() + backtest-week’in okuduğu mum stratejisi (çakışmada A geçerli)

# --- B (referans) ---
ATR_EXPANSION_RATIO=1.3
ATR_PERIOD=14
AsianBlockEnable=false
AsianClosePositions=true
AsianEndHourUTC=6
AsianStartHourUTC=0
FundingFilterEnable=true
FundingLongBiasBelow=-0.0001
FundingShortBiasAbove=0.0001
HTFEMAPeriod=100
HTFInterval=1h
MIN_24H_VOLUME_USD=0
SCANNER_INTERVAL_MIN=5
SCANNER_SYMBOL_DELAY_MS=500
MAX_OPEN_TRADES=5
POSITION_SIZE_USD=100
LEVERAGE=3
EXECUTOR_POLL_INTERVAL_SEC=20

# --- A (sinyal / backtest) ---
STRATEGY_INTERVAL=5m
STRATEGY_RSI_PERIOD=11
STRATEGY_RSI_LOW=45
STRATEGY_RSI_HIGH=60
STRATEGY_RSI_SLOPE_ENABLE=true
STRATEGY_MIN_VOLUME_USD=75000
STRATEGY_VOLUME_RATIO=2.5
STRATEGY_VOLUME_AVG_PERIOD=20
STRATEGY_VOLUME_MIN_RATIO_AVG=1.2
EMA_FAST=20
EMA_SLOW=100
ORDERBOOK_IMBALANCE_ENABLE=false
ORDERBOOK_IMBALANCE_LONG_MIN=0.65
ORDERBOOK_IMBALANCE_SHORT_MAX=0.35
ORDERBOOK_DEPTH_LIMIT=5
ORDERBOOK_SIM_IMBALANCE=0.66
VOLATILITY_EXPANSION_ENABLE=true
LIQUIDATION_CASCADE_ENABLE=false
LIQUIDATION_WINDOW_SEC=10
LIQUIDATION_MIN_USD=500000

STOP_LOSS_PERCENT=6
TAKE_PROFIT_PERCENT=9
MAX_TRADE_DURATION_MIN=120
COIN_COOLDOWN_MIN=30

TRADE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
