# Binance API (Futures - Testnet önerilir)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_FUTURES_TESTNET=true

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=binancebot
POSTGRES_PASSWORD=
POSTGRES_DB=binancebot
# veya tek satır: DATABASE_URL=postgres://user:pass@localhost:5432/binancebot

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bot ayarları
# BOT_ENABLED=true   → tarama + işlem açık (varsayılan)
# BOT_ENABLED=false  → sadece API/dashboard çalışır, boş servis gibi ayakta kalır
# Tek sembol: TRADE_SYMBOL=BTCUSDT
# Çoklu tarama: TRADE_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT
# STOP_LOSS_PERCENT=2
# TAKE_PROFIT_PERCENT=7
# POSITION_SIZE_USD=50   (marj per pozisyon, USDT)
# LEVERAGE=5             (kaldıraç; işlem büyüklüğü = marj * LEVERAGE, örn. 50*5=250 USDT)
# MAX_OPEN_TRADES=5      (aynı anda en fazla açık pozisyon, 0 = sınırsız)
# MAX_LOSSES_IN_12H=2    (son 12 saatte bu sayıdan fazla zarar varsa yeni işlem açılmaz; 0=kapalı)
# MIN_BALANCE_SHUTDOWN=305  (futures bakiye bu USDT altına inerse bot kapanır; 0=kapalı)

# Örnek strateji (Wilder RSI + hacim ortalama); UI'dan da değiştirilebilir (Ayarlar)
# STRATEGY_INTERVAL=30m
# STRATEGY_RSI_PERIOD=14
# STRATEGY_RSI_LOW=10
# STRATEGY_RSI_HIGH=90
# STRATEGY_MIN_VOLUME_USD=500000
# STRATEGY_VOLUME_RATIO=3
# STRATEGY_VOLUME_AVG_PERIOD=20
# STRATEGY_VOLUME_MIN_RATIO_AVG=1.0
