# Binance API (Futures - Testnet önerilir)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_FUTURES_TESTNET=true
# Başlangıçta açık pozisyonları kapatıp trades tablosunu temizlemek için (sadece testnet): true
# BINANCE_TESTNET_CLEANUP_ON_START=false

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=binancebot
POSTGRES_PASSWORD=
POSTGRES_DB=binancebot
# veya tek satır: DATABASE_URL=postgres://user:pass@localhost:5432/binancebot

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bot ayarları
# BOT_ENABLED=true   → tarama + işlem açık (varsayılan)
# BOT_ENABLED=false  → sadece API/dashboard çalışır, boş servis gibi ayakta kalır
# Tek sembol: TRADE_SYMBOL=BTCUSDT
# Çoklu tarama: TRADE_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT
# STOP_LOSS_PERCENT=3      (RR 1:2 için TP=6)
# TAKE_PROFIT_PERCENT=6
# POSITION_SIZE_USD=100   (RiskPerTrade=0 ise kullanılır)
# LEVERAGE=3
# RISK_PER_TRADE=1        (her işlemde bakiyenin %1'i risk; 0 ise POSITION_SIZE_USD kullanılır)
# MIN_24H_VOLUME_USD=100000000  (sadece 24s hacmi bu USDT üstünde olan coinler taranır; 0=kapalı)
# MAX_OPEN_TRADES=5
# MAX_LOSSES_IN_12H=2
# COIN_COOLDOWN_MIN=30   (sembol kapandıktan sonra bu dakika tekrar açılmaz; 0=kapalı; UI/DB'den de ayarlanır)
# MAX_TRADE_DURATION_MIN=120  (açık pozisyon bu dakikayı aşarsa zorla kapatılır; 0=kapalı; UI/DB'den de ayarlanır)
# MIN_BALANCE_SHUTDOWN=0

# Hybrid strateji (trend + RSI pullback + hacim + orderbook + volatility); UI'dan da değiştirilebilir
# STRATEGY_INTERVAL=5m     (5m önerilir; 15m daha stabil)
# STRATEGY_RSI_PERIOD=7   (pullback için)
# STRATEGY_RSI_LOW=35
# STRATEGY_RSI_HIGH=65
# STRATEGY_MIN_VOLUME_USD=500000
# STRATEGY_VOLUME_RATIO=1.5
# STRATEGY_VOLUME_AVG_PERIOD=20
# STRATEGY_VOLUME_MIN_RATIO_AVG=1.8   (volume spike: mevcut > ortalama * 1.8)
# EMA_FAST=50
# EMA_SLOW=200            (trend: Long = price>EMA200 ve EMA50>EMA200; Short = tersi)

# Orderbook imbalance (bid/(bid+ask) quote vol)
# ORDERBOOK_IMBALANCE_ENABLE=false
# ORDERBOOK_IMBALANCE_LONG_MIN=0.65
# ORDERBOOK_IMBALANCE_SHORT_MAX=0.35
# ORDERBOOK_DEPTH_LIMIT=20

# Volatility expansion: current ATR > avg ATR * ratio
# VOLATILITY_EXPANSION_ENABLE=false
# ATR_PERIOD=14
# ATR_EXPANSION_RATIO=1.4

# Liquidation cascade (WebSocket !forceOrder; henüz implemente değil)
# LIQUIDATION_CASCADE_ENABLE=false
# LIQUIDATION_WINDOW_SEC=10
# LIQUIDATION_MIN_USD=500000
